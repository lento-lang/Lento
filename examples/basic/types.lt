// Types
//
// Concrete type-system examples in the intended Lento surface syntax.
// These are meant to become parser/typechecker tests as the implementation
// grows toward the paper.


// ----------------------------
// Aliases + basic conventions
// ----------------------------

// Sized integers/floats exist (u1, u8, u64, i32, f64, ...), plus numeric supertypes.
type SmallIndex = u8

// Common aliases
type Bytes = [u8]
type Path = str

// Some examples use lowercase names (as if they were primitives)
type bytes = Bytes
type path = Path


// ----------------------------
// Refinement (liquid) types
// ----------------------------

// Refined base types have the form `{ v: B | phi }`.
// You can also define a bounded integer range as a refinement.
// `v` names the value being described; `phi` is in an SMT-decidable fragment.
type Nat = { v: int | 0 <= v }
type NonZero = { v: int | v != 0 }
type Age = { v: int | 0 <= v <= 200 }

type Day = { v: int | 1 <= v <= 31 }
type Month = { v: int | 1 <= v <= 12 }
type YearR = { v: int | 0 <= v <= 9999 }
type Date = { day: Day, month: Month, year: Year }

// Value-parameterized refinements (dependent refinement aliases)
type Bounded(n: int) = { v: int | 0 <= v < n }
type Range(lo: int, hi: int) = { v: int | lo <= v <= hi }

type Percent = Range(0, 100)

// ----------------------------
// Records (products)
// ----------------------------

type Point2D = { x: int, y: int }
type Person = { name: str, age: Age }


// ----------------------------
// Sums (enums) + inductives
// ----------------------------

// Enums are sums; variants can carry payloads.
type Option(A) = Some(A) | None
type Result(A, E) = Ok(A) | Err(E)
type Either(A, B) = Left(A) | Right(B)

// Inductive encodings (recursive sums)
type List(A) = Nil | Cons(A, List(A))
type Tree(A) = Leaf(A) | Node(Tree(A), Tree(A))

// A common pattern: represent type class "dictionaries" as records of methods.
// (This uses only existing record types and function types as the basis.)
type Eq(A) = { eq: A -> A -> bool }
type Ord(A) = { lt: A -> A -> bool, eq: A -> A -> bool }

// Paper-style constraints (postfix quantification with class constraints)
type Member(A: Eq) = A -> List(A) -> bool
type Show(A: Type) = { show: A -> str }


// ----------------------------
// Constructor application
// ----------------------------

// Constructor application can be written in a constructor-like form.
type StringIntMap = Map(str, int)
type ByteToByteMap = Map(u8, u8)

// Lists as types via brackets
type Ints = [int]
type Points = [Point2D]


// ----------------------------
// Polymorphism (forall / all)
// ----------------------------

// Type signatures can quantify type variables at the end.
fn id<a> :: a -> a
fn id(x) = x

fn compose<a, b, c> :: (b -> c) -> (a -> b) -> a -> c
fn compose(f, g, x) = f(g(x))

// Union/sum types at the type level
type IntOrStr = int | str
type Json = null | bool | int | float | str | [Json] | Map(str, Json)

// ----------------------------
// Dependent(-ish) types
// ----------------------------

// Length-indexed vectors (dependent refinement + a measure/predicate)
// `len` is treated as a logical measure in refinements.
type Length(T) = { len : T -> int }
type Resize(T) = { resize : T -> int -> T }
type Vec(n: int, A: Type): Length, Resize = { v: [A; n] | len(v) == n }
type MatrixVec(rows: int, cols: int, A: Type) = Vec(rows, Vec(cols, A))
type Matrix(rows: int, cols: int, A: Type) = { v: [[A; rows]; cols], r: int | len(v) == rows && len(v[r]) == cols && 0 <= r < rows }

// ----------------------------
// Type classes (dictionary passing)
// ----------------------------

type Eq = { eq : Self -> Self -> bool }

// Instance selection via type application.
// Dictionaries are values; methods are record projections.
let (Eq int).eq = prim_int_eq

// A derived instance can be a polymorphic function that requires a constraint.
fn (Eq List T).eq<T: Eq>(xs, ys) = list_eq_by(T.eq, xs, ys)

// Operator definition via infix declaration.
// infix left 4 (==)<a> : a -> a -> bool = (Eq a).eq

// A function signature with a type class constraint.
fn member<a: Eq> :: a -> List a -> bool
fn member(x, xs) = intrinsic.todo

