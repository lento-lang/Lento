// Types
//
// This file collects type-system examples using Lento's intended surface syntax,
// plus (commented) excerpts of the paper/core syntax for reference.

// Invariants can be expressed directly as liquid refinement types.
// Refined base types have the form `{ v: B | phi }`.
type Day = { v: Int | 1 <= v and v <= 31 }


// Numeric lattice (illustrative)
// Lento has sized integers/floats (e.g. u1, u8, u64, i32, f64) plus a `num` top.
type Age = { v: Int | 0 <= v and v <= 200 }
type Percent = { v: Int | 0 <= v and v <= 100 }
type SmallIndex = u8


// Type aliases (sugar)
type Bytes = [u8]
type Path = str


// Liquid refinement types (paper/core syntax)
// Refined base types have the form `{ v: B | phi }` where `phi` is in an
// SMT-decidable fragment and `v` refers to the value being described.
//
// Examples:
//     type Nat = { v: Int | 0 <= v }
//     type NonZero = { v: Int | v != 0 }
//     type Bounded(n: Int) = { v: Int | 0 <= v and v < n }


// Dependent types (paper/core syntax)
// Types can be parameterized by values to encode relationships.
//
//     type Vec(n: Int, a: Type) = { v: [a; n] | Vec.len(v) = n }
//
// This is the “length-indexed list” pattern.


// Record and sum types (surface)
// Record types use `{ field: Type, ... }`.
type Point2D = { x: int, y: int }

// Sum types are written as enums.
type Option(A) = Some(A) | None

// Record and inductive/sum types (paper/core syntax)
//
//     Point2D ::= record{ x: int, y: int }
//     Option a ::= sum{ Some: a, None: unit }
//     List a ::= inductive{ Nil: unit, Cons: Sigma head: a . List a }


// Polymorphism and type classes (paper surface style)
// Universal quantification is written postfix via `all`:
//
//     id :: a -> a all a: Type
//
// Constraints elaborate to implicit evidence parameters:
//
//     member :: a -> List a -> bool all a: Eq


// Modal types (paper/core syntax)
//
//     type Now(a: Type) = square a
//     type Later(a: Type) = diamond a
//
// Often used to model async/await style temporal availability.


// Session types (paper/core syntax)
//
//     Ping = !unit . ?unit . end
//     Branch = &{ Left: end, Right: end }
//     Select = xor{ A: end, B: end }
//
// `Chan(S)` carries a channel following protocol `S`.


// Singleton literal types (paper/core syntax)
//
//     Answer = literal(42)


// Effect-annotated function types
// Effects are part of the computation type, not the value type.
//
// Surface:
//     type ReadConfig = Path -> Bytes ! { File.read, throw IOError }
//     type PureInc = int -> int ! { }
//
// Paper/core category E includes forms like:
//     x: tau_i -> epsilon -> tau_j
//     tau_i ! epsilon -> tau_j
//     tau_i ? epsilon -> tau_j


// Type constructor application (surface)
// The compiler's type AST represents constructor application; surface examples
// commonly use space-separated application.
type StringIntMap = Map(str, Int)

// Paper/core syntax also admits application as juxtaposition:
//     Map str Int
// The internal printed form is typically constructor-like:
//     Map(str, Int)


// Universes (paper/core syntax)
// The paper uses a cumulative hierarchy of universes to avoid paradoxes:
//     Type_i
