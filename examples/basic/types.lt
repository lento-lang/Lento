// Types
//
// Concrete type-system examples in the intended Lento surface syntax.
// These are meant to become parser/typechecker tests as the implementation
// grows toward the paper.


// ----------------------------
// Aliases + basic conventions
// ----------------------------

// Sized integers/floats exist (u1, u8, u64, i32, f64, ...), plus numeric supertypes.
type SmallIndex = u8

// Common aliases
type Bytes = [u8]
type Path = str

// Some examples use lowercase names (as if they were primitives)
type bytes = Bytes
type path = Path


// ----------------------------
// Refinement (liquid) types
// ----------------------------

// Refined base types have the form `{ v: B | phi }`.
// `v` names the value being described; `phi` is in an SMT-decidable fragment.
type Nat = { v: int | 0 <= v }
type NonZero = { v: int | v != 0 }
type Percent = { v: int | 0 <= v <= 100 }
type Age = { v: int | 0 <= v <= 200 }
type Day = { v: int | 1 <= v <= 31 }

// Value-parameterized refinements (dependent refinement aliases)
type Bounded(n: int) = { v: int | 0 <= v < n }
type Range(lo: int, hi: int) = { v: int | lo <= v <= hi }

// Surface sugar often written using ranges
// (e.g. `if x in 1..31 { ... }` in statements examples)
type Month = int in 1..12
type Year = int in 0..9999


// ----------------------------
// Records (products)
// ----------------------------

type Point2D = { x: int, y: int }
type Person = { name: str, age: Age }
type Date = { day: Day, month: Month, year: Year }

// Tuple-style product (as used in `examples/types/ranges.lt`)
type DateTuple = (day: Day, month: Month, year: Year)


// ----------------------------
// Sums (enums) + inductives
// ----------------------------

// Enums are sums; variants can carry payloads.
type Option(A) = Some(A) | None
type Result(A, E) = Ok(A) | Err(E)
type Either(A, B) = Left(A) | Right(B)

// Inductive encodings (recursive sums)
type List(A) = Nil | Cons(A, List(A))
type Tree(A) = Leaf(A) | Node(Tree(A), Tree(A))

// A common pattern: represent type class "dictionaries" as records of methods.
// (This uses only existing record types and function types as the basis.)
type Eq(A) = { eq: (A, A) -> bool }
type Ord(A) = { lt: (A, A) -> bool, eq: (A, A) -> bool }

// Paper-style constraints (postfix quantification with class constraints)
type Member = A -> List(A) -> bool all A: Eq
type Show = { show: A -> str } all A: Type


// ----------------------------
// Constructor application
// ----------------------------

// Constructor application can be written in a constructor-like form.
type StringIntMap = Map(str, int)
type ByteToByteMap = Map(u8, u8)

// Lists as types via brackets
type Ints = [int]
type Points = [Point2D]


// ----------------------------
// Polymorphism (forall / all)
// ----------------------------

// Generic functions (forall in the paper)
fn id<A>(x: A) -> A = x

fn compose<A, B, C>(f: B -> C, g: A -> B, x: A) -> C {
    f(g(x))
}

fn map<A, B>(xs: [A], f: A -> B) -> [B] {
    // Intended surface: this would desugar to a fold.
    intrinsic.todo
}

// Postfix quantification style from the paper (as a type alias)
type Id = A -> A all A: Type

// Union/sum types at the type level
type IntOrStr = int | str
type Json = null | bool | int | float | str | [Json] | Map(str, Json)


// ----------------------------
// Dependent(-ish) types
// ----------------------------

// Length-indexed vectors (dependent refinement + a measure/predicate)
// `len` is treated as a logical measure in refinements.
type Vec(n: int, A: Type) = { v: [A; n] | Vec.len(v) == n }

// Finite set {0..n-1}
type Fin(n: int) = { v: int | 0 <= v < n }

// Matrix as a vector of rows
type Matrix(rows: int, cols: int, A: Type) = Vec(rows, Vec(cols, A))


// ----------------------------
// Effectful computation types
// ----------------------------

// Effects are part of computation types.
type PureInc = int -> int ! { }
type ReadConfig = path -> bytes ! { File.read, throw IOError }

// Effect-polymorphic function type alias
type WithEff(A: Type, B: Type, e: Effect) = A -> B ! { e }


// ----------------------------
// Modal types (Now/Later)
// ----------------------------

// Paper uses `square` / `diamond`; we keep constructor-like application.
type Now(A: Type) = square(A)
type Later(A: Type) = diamond(A)

fn pure<A>(x: A) -> Now(A) = square(x)
fn await<A>(x: Later(A)) -> A ! { Async.await } = intrinsic.todo


// ----------------------------
// Session types
// ----------------------------

// Paper-style session syntax (intended to be parsed as types)
type Ping = !unit . ?unit . end
type Branch = &{ Left: end, Right: end }
type Select = xor{ A: end, B: end }

// A channel carrying a protocol
type Chan(S: Session) = Chan(S)

fn send<T, S>(c: Chan(!T . S), x: T) -> Chan(S) ! { Net.send } = intrinsic.todo
fn recv<T, S>(c: Chan(?T . S)) -> (T, Chan(S)) ! { Net.recv } = intrinsic.todo


// ----------------------------
// Singleton literal types
// ----------------------------

type Answer = 42 // literal(42)
fn only_answer(x: Answer) -> int ensures { result == 42 } = 42

